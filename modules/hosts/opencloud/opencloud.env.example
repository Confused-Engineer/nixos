# Example for /etc/opencloud.env on the `opencloud` host. Copy to the host,
# fill in, `chmod 0600`, then `systemctl restart opencloud`. Loaded via
# services.opencloud.environmentFile (see configuration.nix); anything set
# here overrides the `environment` block there. Never commit the real file.

# Password of the read-only bind user in lldap (`uid=opencloud,ou=people,…`,
# member of `lldap_strict_readonly`). The DN itself is set in configuration.nix.
OC_LDAP_BIND_PASSWORD=changeme

# entryUUID of the lldap user that gets the OpenCloud *Admin* role — every
# other lldap user logs in as a regular User. Look it up with:
#   ldapsearch -x -H ldap://10.87.6.10:3890 \
#     -D "uid=opencloud,ou=people,dc=a5f,dc=org" -W \
#     -b "ou=people,dc=a5f,dc=org" "(uid=YOUR_USERNAME)" entryUUID
OC_ADMIN_USER_ID=00000000-0000-0000-0000-000000000000
